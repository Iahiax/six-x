[Unit]
Description=Capital AI-X Quantitative Trading Engine
After=network.target tor.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/capital-ai-x
ExecStart=/root/capital-ai-x/venv/bin/python main.py
Restart=always
RestartSec=10
EnvironmentFile=/root/capital-ai-x/.env

[Install]
WantedBy=multi-user.target
