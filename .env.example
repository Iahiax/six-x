# ==================== Capital.com API ====================
CAPITAL_API_KEY=your_capital_api_key_here
CAPITAL_IDENTIFIER=your_account_email_or_login
CAPITAL_PASSWORD=your_account_password
CAPITAL_API_URL=https://demo-api-capital.backend-capital.com/api/v1
CAPITAL_WS_URL=wss://demo-api-streaming.backend-capital.com/connect
CAPITAL_MODE=DEMO

# ==================== Telegram Control ====================
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=987654321

# ==================== SSH / Tor ====================
SSH_HOSTNAME=segfault.net
SSH_PORT=22
SSH_USERNAME=root
SSH_KEY_PATH=/root/.ssh/id_rsa

TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050

# ==================== Risk Controls ====================
MAX_DAILY_DRAWDOWN_PCT=0.05
MAX_POSITION_SIZE_PCT=0.05
CONFIDENCE_THRESHOLD=0.80
MAX_SLIPPAGE_POINTS=0.5

# ==================== Consensus & Portfolio ====================
CONSENSUS_THRESHOLD=0.65
DEFAULT_CAPITAL=100000
MAX_LEVERAGE=2.0
MAX_ASSET_WEIGHT=0.35
VPIN_THRESHOLD=0.50
VPIN_WINDOW=50

# ==================== Trading Mode (DEMO is the safe default) ====================
TRADING_MODE=DEMO

# ==================== Database & Logging ====================
QUESTDB_HOST=localhost
QUESTDB_PORT=9009
LOG_LEVEL=INFO
LOG_FILE=logs/trading_system.log
